# Переменные для docker-compose
# Скопируй в .env и заполни (ВНИМАНИЕ: не коммить .env в git!)

# Home Assistant
HA_URL=http://192.168.1.2:8123
HA_TOKEN=

# Telegram
TG_TOKEN=
ALLOW_USERS=

# LLM (GigaChat или OpenAI-совместимые)
# GigaChat: Basic-ключ; OpenAI: API key (sk-...)
LLM_CREDENTIALS=
LLM_PROVIDER=gigachat
LLM_MODEL=GigaChat-2-Pro
# GigaChat: https://api.giga.chat (новый целевой URL; Ultra доступна только там)
LLM_BASE_URL=

# Persistence
DATA_DIR=/data